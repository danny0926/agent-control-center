# 首次安裝可複製為未追蹤 .env；既有安裝不要覆寫原帳密。
# 對外代理/tunnel 必須由 owner 同時設定自己的帳號與強密碼。
# 空白只供本機 loopback 使用；缺半組帳密拒絕啟動。
CONTROL_CENTER_USER=
CONTROL_CENTER_PASSWORD=
CONTROL_CENTER_MODE=standalone

# 執行動作預設全拒絕；按已核准需求逐項加入，不支援萬用字元。
# 支援名稱：agent.start,agent.message,shell.create,shell.execute,run.stop
# 名稱存在不代表該動作的 API 已交付；run.stop 尚未提供。
CONTROL_CENTER_ALLOWED_ACTIONS=

# 額外允許的瀏覽器 origin；正式同源部署可清空此值。
CONTROL_CENTER_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CONTROL_CENTER_BACKGROUND_ENABLED=1
CONTROL_CENTER_RECONCILE_SECONDS=60

# 選用：SQLite 完整檔案路徑。不設定則使用專案 data/control-center.db。
# CONTROL_CENTER_DB=/absolute/private/path/control-center.db
